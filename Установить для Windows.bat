@echo off
rem Installer wrapper for Windows. All Russian text lives in windows\install.ps1
rem (PowerShell handles Cyrillic reliably; this .bat is ASCII-only on purpose).
if exist "%~dp0windows\install.ps1" goto run
powershell -NoProfile -EncodedCommand 
pause
exit /b 1
:run
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0windows\install.ps1"
if errorlevel 1 pause
exit /b 0
